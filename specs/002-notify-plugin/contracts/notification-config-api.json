{
  "openapi": "3.0.0",
  "info": {
    "title": "通知配置 API",
    "description": "Claude Code 通知插件配置管理接口",
    "version": "1.0.0",
    "contact": {
      "name": "StartVibe Team",
      "email": "startvibe@linlaoshi.top"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "file://./.claude-plugin/notify",
      "description": "本地文件系统接口"
    }
  ],
  "paths": {
    "/config": {
      "summary": "通知配置文件操作",
      "description": "管理通知插件的配置文件，包括读取、更新和验证配置"
    },
    "/config/validate": {
      "summary": "验证配置文件",
      "description": "验证当前配置文件的格式和内容是否符合规范"
    },
    "/config/default": {
      "summary": "重置为默认配置",
      "description": "将配置文件重置为默认设置"
    },
    "/config/backup": {
      "summary": "备份配置文件",
      "description": "创建当前配置文件的备份"
    },
    "/config/restore": {
      "summary": "恢复配置文件",
      "description": "从备份恢复配置文件"
    }
  },
  "components": {
    "schemas": {
      "NotificationConfig": {
        "$ref": "./notification-config-schema.json"
      },
      "EventConfig": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "是否启用此类型的通知",
            "default": true
          },
          "sound": {
            "type": "boolean",
            "description": "是否播放声音提醒",
            "default": true
          },
          "urgency": {
            "type": "string",
            "enum": ["low", "normal", "critical"],
            "description": "通知紧急程度",
            "default": "normal"
          }
        },
        "required": ["enabled"]
      },
      "MacOSSettings": {
        "type": "object",
        "properties": {
          "appName": {
            "type": "string",
            "description": "应用程序名称",
            "maxLength": 100
          },
          "sound": {
            "type": "string",
            "description": "系统声音名称",
            "maxLength": 50
          }
        }
      },
      "WindowsSettings": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "description": "Windows 应用程序 ID",
            "maxLength": 100
          },
          "toastStyle": {
            "type": "string",
            "enum": ["classic", "modern"],
            "description": "通知样式"
          }
        }
      },
      "LinuxSettings": {
        "type": "object",
        "properties": {
          "urgency": {
            "type": "string",
            "enum": ["low", "normal", "critical"],
            "description": "默认通知紧急程度"
          },
          "category": {
            "type": "string",
            "description": "通知分类"
          }
        }
      }
    },
    "examples": {
      "NotificationConfigExample": {
        "summary": "通知配置示例",
        "description": "完整的通知配置文件示例",
        "value": {
          "version": "1.0.0",
          "lastModified": 1700123456789,
          "enabled": true,
          "defaultSound": true,
          "events": {
            "stop": {
              "enabled": true,
              "sound": true,
              "urgency": "normal"
            },
            "notification": {
              "enabled": true,
              "sound": true,
              "urgency": "critical"
            }
          },
          "display": {
            "title": "Claude Code",
            "message": "{{title}}: {{message}}",
            "duration": 5
          },
          "platformSettings": {
            "macos": {
              "appName": "Claude Code",
              "sound": "Glass"
            },
            "windows": {
              "appId": "ClaudeCode.Notify",
              "toastStyle": "modern"
            },
            "linux": {
              "urgency": "normal",
              "category": "im.received"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/config": {
      "get": {
        "summary": "获取通知配置",
        "description": "读取当前的通知配置文件",
        "tags": ["config", "read"],
        "responses": {
          "200": {
            "description": "成功返回配置文件",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationConfig"
                }
              }
            }
          },
          "404": {
            "description": "配置文件不存在"
          },
          "500": {
            "description": "读取配置文件时发生错误"
          }
        }
      },
      "put": {
        "summary": "更新通知配置",
        "description": "保存新的通知配置设置",
        "tags": ["config", "update"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "配置更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationConfig"
                }
              }
            }
          },
          "400": {
            "description": "配置文件格式无效"
          },
          "500": {
            "description": "保存配置文件时发生错误"
          }
        }
      },
      "delete": {
        "summary": "删除配置文件",
        "description": "删除通知配置文件（将回退到默认设置）",
        "tags": ["config", "delete"],
        "responses": {
          "200": {
            "description": "配置文件删除成功"
          },
          "404": {
            "description": "配置文件不存在"
          },
          "500": {
            "description": "删除配置文件时发生错误"
          }
        }
      }
    },
    "/config/validate": {
      "post": {
        "summary": "验证配置文件",
        "description": "验证当前配置文件的格式和内容是否符合规范",
        "tags": ["config", "validate"],
        "responses": {
          "200": {
            "description": "配置文件验证通过",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          },
          "400": {
            "description": "配置文件验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          },
          "500": {
            "description": "验证过程中发生错误"
          }
        }
      }
    },
    "/config/default": {
      "post": {
        "summary": "重置为默认配置",
        "description": "将配置文件重置为默认设置",
        "tags": ["config", "reset", "default"],
        "responses": {
          "200": {
            "description": "配置重置成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationConfig"
                }
              }
            }
          },
          "500": {
            "description": "重置配置时发生错误"
          }
        }
      }
    },
    "/config/backup": {
      "post": {
        "summary": "备份配置文件",
        "description": "创建当前配置文件的备份",
        "tags": ["config", "backup"],
        "responses": {
          "200": {
            "description": "备份创建成功",
            "content": {
              "application/json": {
                "properties": {
                  "backupPath": {
                    "type": "string",
                    "description": "备份文件路径"
                  }
                }
              }
            }
          },
          "409": {
            "description": "备份文件已存在"
          },
          "500": {
            "description": "创建备份时发生错误"
          }
        }
      }
    },
    "/config/restore": {
      "post": {
        "summary": "恢复配置文件",
        "description": "从备份恢复配置文件",
        "tags": ["config", "restore"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "backupPath": {
                    "type": "string",
                    "description": "备份文件路径"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "配置恢复成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationConfig"
                }
              }
            }
          },
          "404": {
            "description": "备份文件不存在"
          },
          "500": {
            "description": "恢复配置时发生错误"
          }
        }
      }
    }
  }
}