{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code Plugin Hooks Configuration",
  "description": "Claude Code 插件 hooks 配置文件 schema",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "hooks 配置的描述"
    },
    "hooks": {
      "type": "object",
      "patternProperties": {
        "^(PreToolUse|PostToolUse|Notification|UserPromptSubmit|Stop|SubagentStop|PreCompact|SessionStart|SessionEnd)$": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/hookMatcher"
          }
        }
      }
    }
  },
  "definitions": {
    "hookMatcher": {
      "type": "object",
      "properties": {
        "matcher": {
          "oneOf": [
            {
              "type": "string",
              "description": "工具名称匹配模式（支持正则表达式）"
            },
            {
              "type": "null"
            }
          ],
          "description": "用于匹配工具名称的模式（仅适用于 PreToolUse 和 PostToolUse）"
        },
        "hooks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/hook"
          },
          "minItems": 1
        }
      }
    },
    "hook": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["command", "prompt"],
          "description": "Hook 执行类型"
        },
        "command": {
          "type": "string",
          "description": "要执行的 bash 命令（对于 type: \"command\"）"
        },
        "prompt": {
          "type": "string",
          "description": "要发送给 LLM 进行评估的提示（对于 type: \"prompt\"）"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "hook 应运行的时间（以秒为单位），超时后取消该特定 hook"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "command" }
          },
          "required": ["type", "command"]
        },
        {
          "properties": {
            "type": { "const": "prompt" }
          },
          "required": ["type", "prompt"]
        }
      ]
    }
  }
}
