{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code Plugin Metadata",
  "description": "Claude Code 插件元数据配置文件 schema",
  "type": "object",
  "required": ["name", "version", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "插件唯一名称，必须符合 npm 包命名规范"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$",
      "description": "语义版本号 (semver)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "插件描述，建议使用中文"
    },
    "author": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      ]
    },
    "license": {
      "type": "string",
      "description": "开源许可证，如 MIT、Apache-2.0 等"
    },
    "main": {
      "type": "string",
      "description": "插件主入口文件路径"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/agent"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/skill"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependency"
      }
    },
    "engines": {
      "type": "object",
      "properties": {
        "claude": {
          "type": "string",
          "description": "Claude Code 最低版本要求"
        },
        "node": {
          "type": "string",
          "description": "Node.js 最低版本要求"
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repository": {
      "$ref": "#/definitions/repository"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "bugs": {
      "$ref": "#definitions/bugs"
    },
    "scripts": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9-]*$": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "command": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "type": {
          "enum": ["required", "optional", "peer"]
        }
      }
    },
    "repository": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "bugs": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    }
  }
}
