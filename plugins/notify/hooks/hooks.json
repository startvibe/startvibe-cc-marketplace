{
  "description": "Cross-platform system notifications for Claude Code events using @startvibe/node-notifier-cli with context awareness",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/notify-hook.js",
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/notify-hook.js",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
